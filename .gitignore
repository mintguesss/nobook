# ── 模型與二進位（14 GB，用 scripts/fetch_assets.py 重新下載）──────────
models/
tools/

# ── 上課資料（逐字稿、錄音、筆記都是實際課堂內容，不進版控）───────────
data/*
!data/bench.json
!data/.gitkeep
*.flac
*.wav

# 匯出到根目錄的筆記草稿
/*_學習單.md
/*_完整版.md
/*_手抄版.md

# ── 測試素材：tests/fixtures 裡是真實課堂錄音 ─────────────────────────
tests/fixtures/*.wav
tests/fixtures/*.m4a
tests/fixtures/*.flac

# ── 暫存 ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
staging/
*.log
.DS_Store
Thumbs.db

# ── 憑證與私鑰：絕對不能進版控 ──────────────────────────────────────
*.key
*.pem
*.crt
*.pfx
.env
.env.*

# ── 教材：老師的投影片，不是我的東西 ──────────────────────────────
# 課程資料夾的「結構」進版控（clone 下來就有地方放），裡面的檔案不進。
materials/*
!materials/.gitkeep
!materials/README.md
!materials/*/
materials/*/*
!materials/*/.gitkeep

# ── 搬家包：裡面是實際的錄音與逐字稿，只用隨身碟／OneDrive 傳 ────────
搬家包/
搬家包.zip
搬家包*.zip
*.zip
